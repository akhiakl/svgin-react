{
  "name": "svgin-react",
  "version": "0.7.0",
  "description": "Securely fetch and inline SVGs as React components.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/client.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "react-server": "./dist/server.js",
      "react-client": "./dist/client.js",
      "import": "./dist/client.js",
      "require": "./dist/client.js"
    },
    "./client": {
      "import": "./dist/client.js",
      "require": "./dist/client.js"
    },
    "./server": {
      "import": "./dist/server.js",
      "require": "./dist/server.js"
    },
    "./core": {
      "import": "./dist/core.js",
      "require": "./dist/core.js"
    }
  },
  "peerDependencies": {
    "dompurify": "^3.4.14",
    "jsdom": "^26.1.0 || ^27.0.0 || ^28.0.0 || ^29.0.0 || ^30.0.0",
    "react": "^19.1.0"
  },
  "peerDependenciesMeta": {
    "dompurify": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.11",
    "dompurify": "^3.4.14",
    "eslint": "^10.9.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.12.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "pnpm exec eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/check-bundle-size.mjs"
  },
  "keywords": [
    "react",
    "svgin-react",
    "react-svgin",
    "svgin",
    "inline-svg",
    "inline svg",
    "inline react svg",
    "svg",
    "inline",
    "component",
    "sanitize",
    "dompurify"
  ],
  "author": "",
  "license": "MIT"
}