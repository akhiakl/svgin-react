{
  "name": "svgin-react",
  "version": "1.0.0",
  "description": "Securely fetch and inline SVGs from URLs as React components, sanitized by default, with client and server support.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/client.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akhiakl/svgin-react.git"
  },
  "homepage": "https://github.com/akhiakl/svgin-react#readme",
  "bugs": {
    "url": "https://github.com/akhiakl/svgin-react/issues"
  },
  "exports": {
    ".": {
      "react-server": "./dist/server.js",
      "react-client": "./dist/client.js",
      "import": "./dist/client.js",
      "require": "./dist/client.js"
    },
    "./client": {
      "import": "./dist/client.js",
      "require": "./dist/client.js"
    },
    "./server": {
      "import": "./dist/server.js",
      "require": "./dist/server.js"
    },
    "./core": {
      "import": "./dist/core.js",
      "require": "./dist/core.js"
    },
    "./suspense": {
      "import": "./dist/suspense.js",
      "require": "./dist/suspense.js"
    },
    "./shadow": {
      "import": "./dist/shadow.js",
      "require": "./dist/shadow.js"
    },
    "./all": {
      "import": "./dist/all.js",
      "require": "./dist/all.js"
    }
  },
  "peerDependencies": {
    "dompurify": "^3.4.14",
    "jsdom": "^26.1.0 || ^27.0.0 || ^28.0.0 || ^29.0.0 || ^30.0.0",
    "react": "^19.1.0"
  },
  "peerDependenciesMeta": {
    "dompurify": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.11",
    "dompurify": "^3.4.14",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "husky": "9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "pnpm exec eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/check-bundle-size.mjs",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "keywords": [
    "react",
    "svgin-react",
    "react-svgin",
    "svgin",
    "inline-svg",
    "inline svg",
    "inline react svg",
    "svg",
    "svg loader",
    "svg icon",
    "remote svg",
    "inline",
    "component",
    "sanitize",
    "sanitize-svg",
    "sanitize svg react",
    "svg sanitizer",
    "dompurify",
    "xss",
    "svg xss",
    "security",
    "nextjs",
    "next.js svg",
    "rsc",
    "react-server-components",
    "react server components svg",
    "app router",
    "typescript",
    "react suspense",
    "lazy loading",
    "svg lazy load"
  ],
  "author": "Akhil K",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}